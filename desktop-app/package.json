{
  "name": "itemcode-desktop",
  "version": "0.3.1",
  "description": "Cross-platform desktop UI for equality-itemcode-version",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer/renderer.js",
    "prepare:protected": "node scripts/prepare-protected-runtime.cjs",
    "prepare:bundled": "node scripts/prepare-bundled-runtime.cjs",
    "dist": "electron-builder",
    "dist:release": "node scripts/release-build.cjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "javascript-obfuscator": "^4.1.1"
  },
  "build": {
    "appId": "local.itemcode.desktop",
    "productName": "Equality ItemCode Watcher",
    "asar": true,
    "removePackageScripts": true,
    "removePackageKeywords": true,
    "includePdb": false,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "files": [
      {
        "from": ".protected-app",
        "to": ".",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": ".protected-service",
        "to": "equality-itemcode-version",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../equality-itemcode-version",
        "to": "equality-itemcode-version",
        "filter": [
          "package.json",
          "package-lock.json",
          "ocr_helper",
          "ocr_helper.ps1",
          "ocr_image_preprocessor.cs",
          "ocr_helper.swift",
          "service_config.json.example"
        ]
      },
      {
        "from": "../equality-itemcode-version/node_modules",
        "to": "equality-itemcode-version/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bundled/tools",
        "to": "tools",
        "filter": [
          "**/*",
          "!**/.gitkeep"
        ]
      },
      {
        "from": "bundled/playwright-browsers",
        "to": "playwright-browsers",
        "filter": [
          "**/*",
          "!**/.gitkeep"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "icon": "build/icon.icns",
      "artifactName": "Equality-ItemCode-Watcher-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Equality-ItemCode-Watcher-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "nucrasenaa",
      "repo": "itemcode-releases",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
